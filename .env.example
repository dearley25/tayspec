# Copy this file to .env and set your own password.
# This password is required to upload new material — never commit .env itself.
ADMIN_PASSWORD=change-this-password
PORT=3000

# Cloudflare R2 — from your R2 bucket's "Manage API Tokens" page
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=tayspec-resources
# The public URL your bucket serves files from (r2.dev subdomain, or a custom domain you attach)
R2_PUBLIC_URL=https://pub-833f6f82c5164bfb8f35e0201e0fc2fc.r2.dev

# A SECOND bucket, kept private (no public dev URL enabled) — this is where
# paid content lives. Same account, same API keys, different bucket name.
R2_PRIVATE_BUCKET_NAME=tayspec-premium

# Stripe — from dashboard.stripe.com/apikeys. Use a "sk_test_..." key while
# testing, switch to the "sk_live_..." key only once you're ready to charge
# real cards.
STRIPE_SECRET_KEY=sk_test_your_key_here

# The address people reach your site at. localhost while testing, your real
# Render URL once deployed (e.g. https://tayspec.onrender.com) — Stripe needs
# this to know where to send buyers back after checkout.
BASE_URL=http://localhost:3000
